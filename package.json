{
  "name": "agent-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,green \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:client:desktop": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test 'server/**/*.test.ts' 'src/**/*.test.ts'",
    "test:ui": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:host:build": "node scripts/build-desktop-host.mjs",
    "desktop:host:smoke": "node scripts/desktop-host-smoke.mjs",
    "desktop:host:bundle-smoke": "node scripts/desktop-host-smoke.mjs --bundle",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@context-atlas/model": "github:hi-donwi/Context-Atlas#da61e0a257450ef89b798f6fe03d2057c32b2f07&path:/packages/model",
    "@context-atlas/viewer": "github:hi-donwi/Context-Atlas#da61e0a257450ef89b798f6fe03d2057c32b2f07&path:/packages/viewer",
    "@hono/node-server": "^2.1.5",
    "@tauri-apps/api": "^2.12.4",
    "ai": "^7.0.127",
    "highlight.js": "^11.11.0",
    "hono": "^4.13.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uidl-runtime": "^0.1.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.0",
    "esbuild": "0.28.2",
    "oxlint": "^1.81.0",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.3"
  },
  "packageManager": "pnpm@10.18.1",
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider-utils@5.0.53>undici": "7.30.1",
      "shell-quote": "^1.12.0",
      "source-map-js": "^1.2.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "rolldown"
    ]
  }
}
